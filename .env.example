# AI API Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative: OpenAI API
# Get your API key from: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chess Engine Configuration
# Download Stockfish from: https://stockfishchess.org/download/
# Set the path to the Stockfish binary on your system
STOCKFISH_PATH=/usr/local/bin/stockfish
# Windows: C:\Program Files\Stockfish\stockfish.exe
# Mac: /usr/local/bin/stockfish
# Linux: /usr/local/bin/stockfish

# Analysis Settings
ANALYSIS_DEPTH=20
ANALYSIS_TIME_PER_MOVE=1.0
MULTIPV=3

# Database Configuration
DATABASE_PATH=./data/chess_trainer.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/chess_trainer.log

# AI Model Settings
AI_MODEL=claude-3-5-sonnet-20241022
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Thresholds for mistake classification (in centipawns)
BLUNDER_THRESHOLD=300
MISTAKE_THRESHOLD=100
INACCURACY_THRESHOLD=50

# Training Settings
DEFAULT_TRAINING_TIME=1800
PUZZLE_DIFFICULTY=1500
