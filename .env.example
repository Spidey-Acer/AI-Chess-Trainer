# ===========================================
# AI Chess Trainer Configuration
# ===========================================

# -------------------------------------------
# AI Provider Configuration
# -------------------------------------------
# Options: "ollama" (FREE, local), "anthropic" (paid), "openai" (paid)
# RECOMMENDED FOR KIDS: Use "ollama" - completely free!
AI_PROVIDER=ollama

# For Ollama (FREE - no API key needed!)
# 1. Install: curl -fsSL https://ollama.com/install.sh | sh
# 2. Download model: ollama pull llama3.2:3b
# 3. That's it! No API keys, no cost, unlimited usage
AI_MODEL=llama3.2:3b
# Alternative models:
#   llama3.1:8b - Better quality (needs 16GB RAM)
#   mistral:7b - Good alternative
#   phi3:mini - Smallest, fastest

# For Anthropic Claude (optional, paid)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=claude-3-5-sonnet-20241022

# For OpenAI GPT (optional, paid)
# Get your API key from: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=gpt-4

# -------------------------------------------
# Chess Engine Configuration
# -------------------------------------------
# Download Stockfish from: https://stockfishchess.org/download/
# Linux: sudo apt-get install stockfish
# Mac: brew install stockfish
# Windows: Download and set path below

STOCKFISH_PATH=/usr/local/bin/stockfish
# Windows example: C:\Program Files\Stockfish\stockfish.exe
# Mac example: /usr/local/bin/stockfish
# Linux example: /usr/bin/stockfish

# -------------------------------------------
# Analysis Settings
# -------------------------------------------
ANALYSIS_DEPTH=20
ANALYSIS_TIME_PER_MOVE=1.0
MULTIPV=3

# -------------------------------------------
# Database Configuration
# -------------------------------------------
DATABASE_PATH=./data/chess_trainer.db

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/chess_trainer.log

# -------------------------------------------
# AI Model Settings
# -------------------------------------------
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=512

# -------------------------------------------
# Thresholds for mistake classification (in centipawns)
# -------------------------------------------
BLUNDER_THRESHOLD=300
MISTAKE_THRESHOLD=100
INACCURACY_THRESHOLD=50

# -------------------------------------------
# Training Settings
# -------------------------------------------
DEFAULT_TRAINING_TIME=1800
PUZZLE_DIFFICULTY=1500

# -------------------------------------------
# Kid-Friendly Settings
# -------------------------------------------
# Age group for explanations: "7-12" or "13-17"
TARGET_AGE_GROUP=7-12
USE_EMOJIS=true
ENCOURAGEMENT_LEVEL=high
